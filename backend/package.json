{
  "name": "backend",
  "version": "0.1.0",
  "bin": {
    "backend": "bin/backend.js"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "test": "npx jest --clearCache && npx jest --coverage",
    "snap": "npx jest --clearCache && npx jest --updateSnapshot",
    "test.watch": "npx jest --watchAll --coverage",
    "cdk": "cdk",
    "fixlint": "npx eslint --fix --ext .ts ./**",
    "checklint": "npx eslint .",
    "clean": "find ./lib ./bin ./test -type d -name node_modules -prune -o \\( -type f \\( -name \"*.js\" -o -name \"*.d.ts\" \\) -print -exec rm -f {} + \\)",
    "exec": "ts-node -r tsconfig-paths/register"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "22.7.9",
    "aws-cdk": "2.1005.0",
    "cargo-lambda-cdk": "^0.0.33",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "~5.6.3"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.767.0",
    "@aws-sdk/util-dynamodb": "^3.767.0",
    "aws-cdk-lib": "^2.185.0",
    "constructs": "^10.0.0"
  }
}
